---
import { CV_PATH } from '../site.config';

// Built from BASE_URL so the link stays correct if `base` ever changes.
const cvHref = `${import.meta.env.BASE_URL}${CV_PATH}`.replace(/\/{2,}/g, '/');
---

<section class="section cv" id="cv" aria-labelledby="cv-label">
	<div class="ruled cv__row">
		<p class="cv__title" id="cv-label">Full CV, one page.</p>
		<a class="cv__button" href={cvHref} download>Download PDF ↓</a>
	</div>
</section>

<style>
	.cv {
		padding-top: 124px;
	}

	.cv__row {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 32px;
		flex-wrap: wrap;
	}

	.cv__title {
		margin: 0;
		font-family: var(--ff-display);
		font-weight: 300;
		font-size: clamp(22px, 2.4vw, 30px);
		color: var(--text);
	}

	.cv__button {
		font-family: var(--ff-mono);
		font-size: 12px;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--text);
		border: 1px solid var(--accent);
		padding: 15px 26px;
		border-radius: 2px;
		white-space: nowrap;
		transition:
			background 0.25s ease,
			color 0.25s ease;
	}

	.cv__button:hover {
		background: var(--accent);
		color: var(--bg);
	}

	@media (max-width: 720px) {
		.cv {
			padding-top: 92px;
		}
	}
</style>
