---
import { PROJECTS } from '../data/projects';
---

<div id="project-scrim" class="scrim" aria-hidden="true"></div>

<aside
	id="project-panel"
	class="panel"
	role="dialog"
	aria-modal="true"
	aria-label="Project detail"
>
	<div class="panel__inner">
		<div class="panel__bar">
			<button type="button" class="panel__close" data-panel-close aria-label="Close project detail">
				Close ✕
			</button>
		</div>

		{
			PROJECTS.map((project) => (
				<article id={`project-${project.slug}`} data-project-article={project.slug} hidden>
					<p class="panel__stack">{project.stack}</p>
					<h2 class="panel__title" id={`project-${project.slug}-title`}>
						{project.title}
					</h2>
					{project.inProgress && <p class="badge panel__badge">In progress</p>}
					{project.body.split('\n\n').map((paragraph) => (
						<p class="panel__body">{paragraph}</p>
					))}
					{project.why && <p class="panel__why">{project.why}</p>}
				</article>
			))
		}
	</div>
</aside>

<style>
	.scrim {
		position: fixed;
		inset: 0;
		z-index: 50;
		background: rgba(15, 22, 21, 0.62);
		backdrop-filter: blur(2px);
		-webkit-backdrop-filter: blur(2px);
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.35s ease;
	}

	.scrim.is-open {
		opacity: 1;
		pointer-events: auto;
	}

	.panel {
		position: fixed;
		top: 0;
		right: 0;
		bottom: 0;
		z-index: 60;
		width: min(680px, 100vw);
		background: var(--bg);
		border-left: 1px solid rgba(107, 133, 119, 0.35);
		box-shadow: -40px 0 80px rgba(10, 16, 15, 0.5);
		overflow-y: auto;
		overscroll-behavior: contain;

		/* Closed: parked off-canvas. `visibility` flips only after the slide
		 * finishes, so the panel animates out instead of vanishing. */
		transform: translateX(102%);
		visibility: hidden;
		transition:
			transform 0.42s cubic-bezier(0.22, 0.61, 0.36, 1),
			visibility 0s linear 0.42s;
	}

	.panel.is-open {
		transform: translateX(0);
		visibility: visible;
		transition:
			transform 0.42s cubic-bezier(0.22, 0.61, 0.36, 1),
			visibility 0s linear 0s;
	}

	.panel__inner {
		padding: 34px 46px 90px;
	}

	.panel__bar {
		display: flex;
		justify-content: flex-end;
		position: sticky;
		top: 0;
		z-index: 2;
		padding-bottom: 18px;
		background: var(--bg);
	}

	.panel__close {
		appearance: none;
		cursor: pointer;
		background: transparent;
		border: 1px solid rgba(155, 168, 172, 0.3);
		color: var(--muted);
		border-radius: 2px;
		padding: 9px 14px;
		font-family: var(--ff-mono);
		font-size: 11px;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		transition:
			color 0.2s ease,
			border-color 0.2s ease;
	}

	.panel__close:hover {
		color: var(--text);
		border-color: var(--accent);
	}

	.panel__stack {
		margin: 0;
		font-family: var(--ff-mono);
		font-size: 12px;
		letter-spacing: 0.04em;
		color: var(--accent);
	}

	.panel__title {
		margin: 18px 0 0;
		font-family: var(--ff-display);
		font-weight: 400;
		font-size: clamp(26px, 3.4vw, 38px);
		line-height: 1.18;
		color: var(--text);
		text-wrap: balance;
	}

	.panel__badge {
		margin-top: 20px;
	}

	.panel__body {
		margin: 34px 0 0;
		font-size: 17.5px;
		line-height: 1.74;
		font-weight: 300;
		color: var(--text-88);
		text-wrap: pretty;
	}

	/* Paragraph break inside a write-up reads tighter than the gap that
	 * separates the body from the title above it. */
	.panel__body + .panel__body {
		margin-top: 24px;
	}

	.panel__why {
		margin: 36px 0 0;
		padding-left: 22px;
		border-left: 2px solid var(--accent);
		font-size: 16px;
		line-height: 1.66;
		font-style: italic;
		font-weight: 300;
		color: var(--muted);
		text-wrap: pretty;
	}

	/* Mobile: full-screen sheet rising from the bottom edge. Same content,
	 * different presentation — per design_brief.md. */
	@media (max-width: 720px) {
		.panel {
			inset: 0;
			width: 100%;
			border-left: 0;
			border-top: 1px solid rgba(107, 133, 119, 0.35);
			box-shadow: 0 -30px 60px rgba(10, 16, 15, 0.5);
			transform: translateY(100%);
		}

		.panel.is-open {
			transform: translateY(0);
		}

		.panel__inner {
			padding: 22px var(--gutter) 72px;
		}

		.panel__body {
			font-size: 16.5px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.panel {
			transition:
				opacity 0.2s ease,
				visibility 0s linear 0.2s;
			transform: none;
			opacity: 0;
		}

		.panel.is-open {
			transition:
				opacity 0.2s ease,
				visibility 0s linear 0s;
			transform: none;
			opacity: 1;
		}
	}
</style>

<script>
	/*
	 * Project detail panel.
	 *
	 * - Cards are real links to `#project-<slug>`, so every panel is directly
	 *   linkable and survives back/forward.
	 * - Closes on Escape, on scrim (click-outside), and on the close control.
	 * - Focus is trapped while open and returned to the triggering card on close.
	 * - Background scroll is locked while open.
	 */
	const panel = document.getElementById('project-panel');
	const scrim = document.getElementById('project-scrim');
	const cards = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-project-card]'));
	const articles = Array.from(document.querySelectorAll<HTMLElement>('[data-project-article]'));

	if (panel && scrim && cards.length > 0 && articles.length > 0) {
		const slugs = new Set(articles.map((a) => a.dataset.projectArticle).filter(Boolean) as string[]);

		let activeSlug: string | null = null;
		let lastTrigger: HTMLElement | null = null;

		const hashFor = (slug: string) => `#project-${slug}`;

		function slugFromHash(): string | null {
			const match = /^#project-(.+)$/.exec(window.location.hash || '');
			return match && slugs.has(match[1]!) ? match[1]! : null;
		}

		function focusableNodes(): HTMLElement[] {
			return Array.from(
				panel!.querySelectorAll<HTMLElement>(
					'a[href], button:not([disabled]), input, select, textarea, [tabindex]:not([tabindex="-1"])',
				),
			).filter((node) => node.offsetParent !== null || node.offsetWidth + node.offsetHeight > 0);
		}

		function trapFocus(event: KeyboardEvent) {
			const nodes = focusableNodes();
			if (nodes.length === 0) return;
			const first = nodes[0]!;
			const last = nodes[nodes.length - 1]!;

			if (event.shiftKey && document.activeElement === first) {
				event.preventDefault();
				last.focus();
			} else if (!event.shiftKey && document.activeElement === last) {
				event.preventDefault();
				first.focus();
			}
		}

		function setActive(slug: string | null) {
			if (slug === activeSlug) return;
			const wasOpen = activeSlug !== null;
			activeSlug = slug;
			const isOpen = slug !== null;

			if (isOpen) {
				for (const article of articles) {
					article.hidden = article.dataset.projectArticle !== slug;
				}
				const titleId = `project-${slug}-title`;
				if (document.getElementById(titleId)) {
					panel!.setAttribute('aria-labelledby', titleId);
				}
			}
			// On close the previous article stays mounted so the panel still has
			// content while it slides away.

			panel!.classList.toggle('is-open', isOpen);
			scrim!.classList.toggle('is-open', isOpen);
			document.body.classList.toggle('is-locked', isOpen);
			panel!.inert = !isOpen;

			for (const card of cards) {
				card.setAttribute('aria-expanded', String(card.dataset.projectCard === slug));
			}

			if (isOpen) {
				const trigger = cards.find((card) => card.dataset.projectCard === slug);
				if (trigger) lastTrigger = trigger;
				panel!.scrollTop = 0;
				const closeButton = panel!.querySelector<HTMLElement>('[data-panel-close]');
				if (closeButton) requestAnimationFrame(() => closeButton.focus());
			} else if (wasOpen && lastTrigger) {
				const trigger = lastTrigger;
				requestAnimationFrame(() => trigger.focus({ preventScroll: true }));
			}
		}

		function openPanel(slug: string) {
			if (window.location.hash !== hashFor(slug)) {
				history.pushState(null, '', hashFor(slug));
			}
			setActive(slug);
		}

		function closePanel() {
			if (activeSlug === null) return;
			if (/^#project-/.test(window.location.hash || '')) {
				history.pushState(null, '', `${window.location.pathname}${window.location.search}#projects`);
			}
			setActive(null);
		}

		for (const card of cards) {
			card.addEventListener('click', (event) => {
				// Let modified clicks open in a new tab as a normal link would.
				if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
				const slug = card.dataset.projectCard;
				if (!slug) return;
				event.preventDefault();
				openPanel(slug);
			});
		}

		scrim.addEventListener('click', closePanel);

		for (const button of panel.querySelectorAll<HTMLElement>('[data-panel-close]')) {
			button.addEventListener('click', closePanel);
		}

		document.addEventListener('keydown', (event) => {
			if (activeSlug === null) return;
			if (event.key === 'Escape') {
				event.preventDefault();
				closePanel();
			} else if (event.key === 'Tab') {
				trapFocus(event);
			}
		});

		window.addEventListener('hashchange', () => setActive(slugFromHash()));

		panel.inert = true;
		setActive(slugFromHash());
	}
</script>
